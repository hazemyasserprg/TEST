{
  "name": "benaa-clone-app",
  "private": true,
  "version": "1.0.0",
  "description": "Benaa Academy Desktop App",
  "author": "Benaa Engineering Academy",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_RUN_AS_NODE=\"\" NODE_ENV=development electron .\"",
    "electron:preview": "npm run build && cross-env ELECTRON_RUN_AS_NODE=\"\" electron .\"",
    "build:exe": "npm run build && electron-builder --win",
    "build:portable": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.benaa.academy",
    "productName": "Benaa Academy",
    "copyright": "Copyright © 2026 Benaa Academy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Benaa Academy"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  }
}
